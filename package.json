{
  "name": "tab-session-outliner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "test": "vitest run",
    "test:playwright": "playwright test",
    "test:playwright:ci": "playwright test -c playwright.ci.config.ts",
    "trace-hunt:runtime": "node scripts/hunt-runtime-traces.mjs",
    "perf:runtime-guard": "pnpm build && node scripts/perf-runtime-guard.mjs",
    "test:soak": "node scripts/run-generated-soak.mjs",
    "test:watch": "vitest",
    "check": "npm run test && npm run build",
    "perf:sidebar-projection-guard": "pnpm build && node scripts/perf-sidebar-projection-guard.mjs",
    "profile:tab-open": "node scripts/profile-tab-open.mjs",
    "profile:close": "node scripts/profile-close.mjs",
    "profile:delete": "node scripts/profile-delete.mjs",
    "profile:focus": "node scripts/profile-focus.mjs",
    "profile:restore": "node scripts/profile-restore.mjs",
    "profile:diagnostics": "node scripts/profile-diagnostics.mjs",
    "profile:command": "node scripts/profile-command.mjs",
    "profile:drag-drop": "node scripts/profile-drag-drop.mjs",
    "profile:sidebar-startup": "node scripts/profile-sidebar-startup.mjs",
    "analyze:profile-export": "node scripts/profile-export-analysis.mjs",
    "profile:startup-hover": "playwright test tests/playwright/sidebar-startup-interaction-profile.spec.ts --reporter=list",
    "profile:startup-hover-loop": "node scripts/profile-startup-hover.mjs",
    "profile:startup-scroll-away": "node scripts/profile-startup-scroll-away.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.19.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "web-ext": "^8.9.0"
  },
  "packageManager": "pnpm@10.28.1+sha512.7d7dbbca9e99447b7c3bf7a73286afaaf6be99251eb9498baefa7d406892f67b879adb3a1d7e687fc4ccc1a388c7175fbaae567a26ab44d1067b54fcb0d6a316"
}
